{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "globalEnv": [
    "DATABASE_URL",
    "DIRECT_DATABASE_URL",
    "NEXTAUTH_URL",
    "NEXTAUTH_SECRET",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "UPLOADTHING_SECRET",
    "UPLOADTHING_TOKEN",
    "UPLOADTHING_APP_ID",
    "FLW_PUBLIC_KEY",
    "FLW_SECRET_KEY",
    "FLW_WEBHOOK_SECRET",
    "CRON_SECRET",
    "NEXT_PUBLIC_APP_URL",
    "NEXT_PUBLIC_FLW_PUBLIC_KEY",
    "ADMIN_EMAILS",
    "COMPANY_NAME",
    "COMPANY_EMAIL",
    "COMPANY_PHONE",
    "COMPANY_ADDRESS",
    "COMPANY_WHATSAPP"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "clean": {
      "cache": false
    },
    "db:push": {
      "cache": false
    },
    "db:generate": {
      "cache": false
    }
  }
}